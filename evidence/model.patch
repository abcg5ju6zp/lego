++func (g *Generation) matches(domains []string, profile string) (bool, error) {
++	certRaw, err := os.ReadFile(filepath.Join(g.dir, artifactCertificate))
++	if err != nil {
++		return false, fmt.Errorf("read certificate for generation %q: %w", g.id, err)
