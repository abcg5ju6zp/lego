+func thumbOf(key crypto.Signer) string {
+	thumbprint, err := storage.KeyThumbprint(key)
+	if err != nil {
+		panic(err)
+	}
+
+	return thumbprint
+}
+
+func mustThumbprint(t *testing.T, key crypto.Signer) string {
