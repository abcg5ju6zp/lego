++	for _, g := range gens {
++		switch g.Phase() {
++		case phaseStaging:
++			if err := g.remove(); err != nil {
++				return nil, err
++			}
++
++		case phaseStaged:
++			candidate, err := g.classify(domains, profile)
++			if err != nil {
++				return nil, err
++			}
