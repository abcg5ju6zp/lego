+
+	var deployCount int32
+
+	done, err := lease.Recover(ctx, deployStub(&deployCount, nil))
+	require.NoError(t, err)
+	assert.True(t, done)
+	assert.Equal(t, int32(1), atomic.LoadInt32(&deployCount))
+
+	liveCert, err := store.ReadFile(testCertID, ExtCert)
+	require.NoError(t, err)
