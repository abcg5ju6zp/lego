 	}
 
-	pfxBytes, err := encoder.Encode(privateKey, cert, certChain, password)
+	pfxBytes, err := encoder.Encode(privateKey, cert, certChain, opts.PFXPassword)
 	if err != nil {
-		return fmt.Errorf("unable to encode PFX data %q: %w", certRes.ID, err)
