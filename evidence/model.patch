+		return nil, fmt.Errorf("unable to get certificate chain %q: %w", certRes.ID, err)
 	}
 
 	privateKey, err := certcrypto.ParsePEMPrivateKey(certRes.PrivateKey)
 	if err != nil {
-		return fmt.Errorf("unable to parse private ky %q: %w", certRes.ID, err)
